# Customizations on top of gpakosz/.tmux ("oh-my-tmux").
# Edit this file only — the upstream .tmux.conf is vendored as a chezmoi
# external (pinned in .chezmoiexternal.toml.tmpl, extracted to ~/.config/tmux/).

# --- prefix: C-a only (screen-style) ------------------------------------------
# gpakosz binds C-a as prefix2; make it primary and drop C-b entirely.
# Verbatim from the commented-out template snippet in gpakosz's .tmux.conf.local.
set -gu prefix2
unbind C-a
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# --- not set by gpakosz ------------------------------------------------------
set -g mouse on
setw -g mode-keys vi          # activates gpakosz's v/y/H/L/C-v bindings
set -s set-clipboard on       # OSC 52, so vim's "+y reaches the host pasteboard
set-environment -g COLORTERM truecolor   # not propagated into tmux otherwise
set -g history-limit 50000    # gpakosz default is 5000

# --- gpakosz native flags -----------------------------------------------------
tmux_conf_24b_colour=true             # `auto` probes $COLORTERM, which drops over SSH
tmux_conf_copy_to_os_clipboard=true

# Powerline separators, U+E0B0–E0B3 — present in MesloLGS NF and any Nerd Font.
tmux_conf_theme_left_separator_main=''
tmux_conf_theme_left_separator_sub=''
tmux_conf_theme_right_separator_main=''
tmux_conf_theme_right_separator_sub=''

# Palette mirrors the p10k accents, as hex so the SSH-tint branch in zshrc can
# point-override colour_15 (right-side bar background). Unlisted slots keep
# gpakosz's defaults, which already match.

tmux_conf_theme_colour_9='#5fafd7'    # session bg            — p10k light DIR-anchor (74)
tmux_conf_theme_colour_10='#005f87'   # uptime bg             — p10k deep DIR (24)
tmux_conf_theme_colour_13='#080808'   # user fg               — black (override default #e4e4e4)
tmux_conf_theme_colour_16='#5faf5f'   # user bg               — p10k muted OK green (71)
tmux_conf_theme_colour_17='#bcbcbc'   # host bg               — p10k light grey (250)

# colour_4 and colour_5 feed several derived variables each, so set them direct.
# colour_4 → all "live / focused" UI: active window bg, pane border, clock.
tmux_conf_theme_colour_4='#5fd700'   # active highlights      — p10k OK green (76)
# colour_5 → transient cues: messages, copy-mode highlight, bell.
tmux_conf_theme_colour_5='#d7af00'   # messages/mode/bell     — p10k DIRENV mustard (178)

# 2 lines per tick instead of gpakosz's 5 — macOS' trackpad event rate makes 5
# feel jumpy.
bind -T copy-mode-vi WheelUpPane   select-pane \; send-keys -X -N 2 scroll-up
bind -T copy-mode-vi WheelDownPane select-pane \; send-keys -X -N 2 scroll-down
