{{- /*
  Profile-aware mise config. core: fzf+zoxide+jq. dev/workstation: full toolchain.
  Per-machine opt-out: ~/.config/mise/config.local.toml (auto-merged, untracked).
  Adding a tool: `mise registry | grep -i <name>` → add the slug → `chezmoi apply`
  (run_onchange_after_50 embeds this file's hash, so apply auto-runs `mise install`).
*/ -}}
{{- $profile := .profile | default "core" -}}
{{- $isDev   := or (eq $profile "dev") (eq $profile "workstation") -}}
[settings]
# Off upstream since mise 2025.10.0; re-enabled for projects predating mise.toml.
idiomatic_version_file_enable_tools = ["node", "python", "go"]

[settings.github]
# mise only reads gh's hosts.yml, but macOS keeps the token in the Keychain —
# `gh auth token` bridges both. 5000/hr authed vs 60 anon; falls back to anon.
# Unconditional: gh arrives later in the same apply, so a lookPath gate could
# never render on the pass that needs it.
credential_command = "gh auth token"

[tools]
# --- Core: required at every tier ---------------------------------------
"aqua:junegunn/fzf"                         = "latest"   # zshrc Ctrl-R, Ctrl-T
"aqua:ajeetdsouza/zoxide"                   = "latest"   # zshrc z, zi
"aqua:jqlang/jq"                            = "latest"   # Claude statusline; configs ship at every tier

{{- if $isDev }}

# --- Languages ----------------------------------------------------------
node   = "lts"
go     = "latest"
python = "latest"
rust   = "stable"

# --- CLI utilities ------------------------------------------------------
"aqua:cli/cli"                              = "latest"   # gh
"aqua:dandavison/delta"                     = "latest"
"aqua:koalaman/shellcheck"                  = "latest"
"aqua:sharkdp/fd"                           = "latest"
"aqua:gitleaks/gitleaks"                    = "latest"
"aqua:mikefarah/yq"                         = "latest"   # Go yq, NOT Python
"aqua:direnv/direnv"                        = "latest"   # per-project env+secrets (see hook in dot_zshrc)

# --- Cloud + Kubernetes -------------------------------------------------
"aqua:helm/helm"                            = "latest"
"aqua:kubernetes/kubernetes/kubectl"        = "latest"
"aqua:derailed/k9s"                         = "latest"
"aqua:kubernetes-sigs/kustomize"            = "latest"
"aqua:stern/stern"                          = "latest"
"aqua:argoproj/argo-cd"                     = "latest"   # argocd
"aqua:opentofu/opentofu"                    = "latest"   # tofu
"aqua:aws/aws-cli"                          = "latest"
"aqua:rclone/rclone"                        = "latest"
"aqua:cloudflare/cloudflared"               = "latest"

# --- Networking ---------------------------------------------------------
"aqua:vi/websocat"                          = "latest"
"pipx:ssh-audit"                            = "latest"   # SSH config auditor (pipx backend → uv)

# --- Go ecosystem -------------------------------------------------------
"aqua:bufbuild/buf"                         = "latest"
"aqua:golangci/golangci-lint"               = "latest"
"aqua:goreleaser/goreleaser"                = "latest"
"aqua:gotestyourself/gotestsum"             = "latest"
"aqua:protocolbuffers/protobuf-go/protoc-gen-go" = "latest"
"go:golang.org/x/tools/cmd/goimports"       = "latest"   # go backend → go install

# --- JS / Python pkg managers -------------------------------------------
"aqua:pnpm/pnpm"                            = "latest"
"aqua:astral-sh/uv"                         = "latest"

# --- AI CLIs (native binaries, no Node coupling) ------------------------
# If aqua-registry breaks, npm:@anthropic-ai/claude-code / npm:@openai/codex
# resolve identically.
"aqua:anthropics/claude-code"               = "latest"
"aqua:openai/codex"                         = "latest"

# --- Auth + secrets -----------------------------------------------------
op                                          = "latest"   # registry alias for 1password (vfox)


# OS-native packages (htop, nmap, wireguard-tools, postgresql-client) live in
# .chezmoidata/packages.yaml — they have C deps mise would have to rebuild.
#
# mise owns tool versions, direnv owns per-project env + secrets. They only
# collide when both manage a tool, so never use direnv `layout`/`PATH_add`.
{{- end }}
