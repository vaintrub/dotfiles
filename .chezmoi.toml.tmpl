{{- /*
  Rendered to ~/.config/chezmoi/chezmoi.toml by `chezmoi init`; the cached
  profile short-circuits the prompt afterwards. Tiers cascade core ⊂ dev ⊂
  workstation — see README. Default "core" is the safe fallback for CI, a
  non-interactive run or an accidental enter. Re-prompt: `chezmoi init --prompt`.
  Keep the prompt text free of "," and "=" so `--promptChoice` can answer it.
*/ -}}
{{- $profile := promptChoiceOnce . "profile" "Install profile" (list "core" "dev" "workstation") "core" -}}
[data]
    profile = {{ $profile | quote }}
