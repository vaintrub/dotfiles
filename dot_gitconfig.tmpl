{{- /*
  Global git config. A template only for the macOS plist driver; nothing here
  depends on what is installed at render time, so a fresh box's first apply
  already writes the final file.
  - delta and the gh credential helper are wired unconditionally, behind
    runtime `command -v` guards. Both install in script 50, after files are
    written, and a render-time lookPath flapped with whichever PATH ran chezmoi.
  - The gh helper is claimed here because `gh auth login` would write it with
    an absolute gh path that rots on every upgrade.
*/ -}}
[user]
    name = "George Vaintrub"
    email = "george.vaintrub@gmail.com"

[core]
    editor = vim
    excludesFile = ~/.gitignore_global
    autocrlf = input
    # No core.hooksPath on purpose: it REPLACES $GIT_DIR/hooks rather than
    # adding to it, silently disabling whatever a repository installed itself.
    pager = command -v delta >/dev/null 2>&1 && delta || less

[init]
    defaultBranch = master

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

# Without gh the helper exits 0 having printed nothing, and git carries on to
# the next helper or its own prompt.
[credential "https://github.com"]
    helper =
    helper = "!f() { command -v gh >/dev/null 2>&1 || exit 0; exec gh auth git-credential \"$@\"; }; f"

[credential "https://gist.github.com"]
    helper =
    helper = "!f() { command -v gh >/dev/null 2>&1 || exit 0; exec gh auth git-credential \"$@\"; }; f"

[merge]
    # zdiff3 needs git >= 2.35, and the Jetson runs Ubuntu 22.04's 2.34.
    conflictStyle = diff3

[rebase]
    autoSquash = true
    autoStash = true

[diff]
    algorithm = histogram
    colorMoved = default
    submodule = log
{{- if eq .chezmoi.os "darwin" }}

# For `diff=plist` in the dotfiles repo's .gitattributes: a no-op while
# iTerm2 writes XML, readable diffs if a release ever writes binary. Git
# appends the path itself; a trailing `-` for stdin makes plutil fail.
[diff "plist"]
    textconv = plutil -convert xml1 -o -
{{- end }}

[fetch]
    prune = true

[rerere]
    enabled = true

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status -sb
    last = log -1 HEAD --stat
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    wip = !git add -A && git commit -m \"WIP\"
    undo = reset --soft HEAD^
    lg = log --graph --decorate --abbrev-commit --date=short --pretty=format:'%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %C(green)%an%C(reset) %s%C(red)%d%C(reset)'

[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    syntax-theme = Dracula

[interactive]
    # Braced: git < 2.37 (the Jetson) runs `add -p` in Perl, which splices this
    # into "$diff | <filter>", and an unbraced && / || would leave cat reading
    # the terminal. Quoted, because an unquoted ";" starts a gitconfig comment.
    diffFilter = "{ command -v delta >/dev/null 2>&1 && delta --color-only || cat; }"
