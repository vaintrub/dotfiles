{{- /*
  Global git config. Rendered at every chezmoi apply.
  - name/email come from prompts in .chezmoi.toml.tmpl (cached in [data]
    section of ~/.config/chezmoi/chezmoi.toml after first init).
  - delta is wired unconditionally, behind a runtime `command -v` guard. A
    render-time lookPath flapped: delta installs in script 50, after files are
    written, so a first apply rendered without it, and later renders depended
    on whichever PATH ran chezmoi.
  - credential.helper gated on `lookPath "gh"`. Claimed from `gh auth
    login`, which writes it with an absolute gh path that rots on upgrade.
*/ -}}
{{- /*
  Skip [user] block when identity values are still chezmoi placeholders
  ("Your Name" / "you@example.com" set in .chezmoi.toml.tmpl on a
  non-interactive run without --data), so the placeholder is never baked in.
  That does not make git refuse to commit. With no [user] and no system
  config it guesses `<user>@<hostname>`: a Linux box whose hostname has no
  domain stops at "Please tell me who you are", but a Mac (`*.local`)
  commits under the guessed address without a word.
*/ -}}
{{ if and (ne .name "Your Name") (ne .email "you@example.com") -}}
[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
{{ end }}
[core]
    editor = vim
    excludesFile = ~/.gitignore_global
    autocrlf = input
    # No core.hooksPath on purpose: it REPLACES $GIT_DIR/hooks rather than
    # adding to it, silently disabling whatever a repository installed itself.
    pager = command -v delta >/dev/null 2>&1 && delta || less

[init]
    defaultBranch = master

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true
{{ if lookPath "gh" }}
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
{{- end }}

[merge]
{{- /*
  Through sh, not `output "git"`: a missing git, or macOS's CLT stub after an
  OS upgrade, exits non-zero, and `output` then aborts every whole-tree
  command (status, diff, verify, apply). An empty version falls to diff3
  rather than reaching semverCompare, which errors on "".
*/ -}}
{{- $gitVersion := output "sh" "-c" "git --version 2>/dev/null || true" | regexFind "[0-9]+\\.[0-9]+\\.[0-9]+" }}
    # zdiff3 (zealous diff3) needs git >= 2.35; older git (e.g. Ubuntu jammy
    # 2.34) errors "unknown style 'zdiff3'" on checkout/merge. diff3 elsewhere.
{{- if and $gitVersion (semverCompare ">=2.35.0" $gitVersion) }}
    conflictStyle = zdiff3
{{- else }}
    conflictStyle = diff3
{{- end }}

[rebase]
    autoSquash = true
    autoStash = true

[diff]
    algorithm = histogram
    colorMoved = default
    submodule = log

[fetch]
    prune = true
    pruneTags = true

[rerere]
    enabled = true

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status -sb
    last = log -1 HEAD --stat
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    wip = !git add -A && git commit -m \"WIP\"
    undo = reset --soft HEAD^
    lg = log --graph --decorate --abbrev-commit --date=short --pretty=format:'%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %C(green)%an%C(reset) %s%C(red)%d%C(reset)'

[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    syntax-theme = Dracula

[interactive]
    diffFilter = command -v delta >/dev/null 2>&1 && delta --color-only || cat
