#chezmoi:modify-template
{{- /*
  ~/.claude/settings.json. The annotation above makes chezmoi render this as a
  Go template with .chezmoi.stdin = the current target; the output IS the new
  file.

  Two-step deep merge:
  - mergeOverwrite (deepCopy $base) $existing — existing wins, so tool-written
    keys survive (rtk's PreToolUse hook, plugins enabled ad hoc). deepCopy
    because mergeOverwrite mutates its first argument.
  - re-apply $base minus `enabledPlugins` — without it the base could only ADD
    keys, never change one. enabledPlugins stays a union.
  Maps merge recursively; lists would overwrite wholesale.

  CONSTRAINT: the base must not define `hooks` — rtk owns them via
  `rtk init -g --auto-patch`. The `fail` below enforces it.
*/ -}}
{{- $existing := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $existing = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $base := fromJson (includeTemplate "claude-settings-base.json" .) -}}
{{- if hasKey $base "hooks" -}}
{{-   fail "claude-settings-base.json must not define 'hooks' (rtk owns it)" -}}
{{- end -}}
{{- $merged := mergeOverwrite (deepCopy $base) $existing -}}
{{- $merged = mergeOverwrite $merged (omit $base "enabledPlugins") -}}
{{ $merged | toPrettyJson }}
