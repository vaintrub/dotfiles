{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Touch ID for sudo, through /etc/pam.d/sudo_local (macOS 14+): it survives the
# system updates that rewrite /etc/pam.d/sudo. Idempotent. Changing the file
# needs sudo, so with neither a terminal nor passwordless sudo the script fails;
# chezmoi records only a success, and the next interactive apply tries again.
set -eu

target=/etc/pam.d/sudo_local
if grep -qE '^auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so' "$target" 2>/dev/null; then
    exit 0
fi
if ! sudo -n true 2>/dev/null && ! tty -s; then
    echo "ERROR: enabling Touch ID for sudo needs a terminal — re-run chezmoi apply from one." >&2
    exit 1
fi

[ -f "$target" ] || sudo cp /etc/pam.d/sudo_local.template "$target"
# The template ships the pam_tid line commented out.
if grep -qE '^#auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so' "$target"; then
    sudo sed -i '' -E 's/^#(auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so)/\1/' "$target"
else
    echo 'auth       sufficient     pam_tid.so' | sudo tee -a "$target" >/dev/null
fi
echo "Touch ID enabled for sudo ($target)"
{{- end }}
