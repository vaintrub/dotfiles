{{- /*
  Claude + Codex plugins and MCP servers from .chezmoidata/packages.yaml.
  Claude has no declarative user-scope config, so everything goes through its
  CLI. Codex takes its enable flags and MCP servers declaratively from
  .chezmoitemplates/codex-config-base.toml instead.
*/ -}}
#!/bin/sh
set -eu
# Re-run when the tool list or the profile changes, since either can add
# claude, codex or rtk. mise config: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# profile: {{ .profile }}

{{ if eq .chezmoi.os "darwin" -}}
# mise is a Homebrew formula here, and its shims need it on PATH.
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$b" ]; then eval "$("$b" shellenv)"; break; fi
done

{{ end -}}
# claude and codex are mise shims, placed ahead of anything Homebrew or npm
# installed under the same name. chezmoi exec()s every script as a fresh child,
# so no other script's PATH reaches here.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

if command -v claude >/dev/null 2>&1; then
    # Re-added defensively: the marketplace is absent until claude has been
    # launched interactively at least once.
    if ! out=$(claude plugin marketplace add anthropics/claude-plugins-official 2>&1); then
        echo "WARNING: claude plugin marketplace add (official) failed:" >&2
        echo "$out" >&2
    fi
{{- range .plugins.claude_marketplaces }}
{{- $parts := splitn ":" 2 . }}
    if ! out=$(claude plugin marketplace add {{ $parts._1 | shellQuote }} 2>&1); then
        echo {{ printf "WARNING: claude plugin marketplace add %s failed:" $parts._0 | shellQuote }} >&2
        echo "$out" >&2
    fi
{{- end }}
{{- range .plugins.claude }}
    claude plugin install {{ . | shellQuote }} --scope user >/dev/null 2>&1 \
        || echo {{ printf "claude plugin install %s failed" . | shellQuote }} >&2
    claude plugin update {{ . | shellQuote }} >/dev/null 2>&1 || true
{{- end }}
    claude plugin marketplace update >/dev/null 2>&1 || true

    # Idempotent: `mcp get` succeeds when the server is already registered.
{{- range .mcp }}
    if ! claude mcp get {{ .name | shellQuote }} >/dev/null 2>&1; then
        claude mcp add -s user --transport http {{ .name | shellQuote }} {{ .url | shellQuote }} >/dev/null 2>&1 \
            && echo {{ printf "claude mcp add %s" .name | shellQuote }} \
            || echo {{ printf "claude mcp add %s failed" .name | shellQuote }} >&2
    fi
{{- end }}
else
    echo "claude CLI not found, skipping Claude plugin install" >&2
fi

if command -v codex >/dev/null 2>&1; then
{{- range .plugins.codex_marketplaces }}
    codex plugin marketplace add {{ . | shellQuote }} >/dev/null 2>&1 \
        || echo {{ printf "codex plugin marketplace add %s failed" . | shellQuote }} >&2
{{- end }}
    codex plugin marketplace upgrade >/dev/null 2>&1 || true
else
    echo "codex CLI not found, skipping Codex plugin install" >&2
fi

# rtk's linux-arm64 build needs glibc >= 2.39 (Ubuntu 24.04+), so probe that it
# runs before letting it patch either agent's config.
if command -v rtk >/dev/null 2>&1 && rtk --version >/dev/null 2>&1; then
    if command -v claude >/dev/null 2>&1; then
        rtk init -g --auto-patch
    fi
    # -g pins the write to ~/.codex/, not cwd ($HOME under chezmoi apply).
    if command -v codex >/dev/null 2>&1; then
        rtk init -g --codex
    fi
fi
