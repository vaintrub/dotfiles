{{- /*
  Claude + Codex plugins and MCP servers from .chezmoidata/packages.yaml.
  Claude has no declarative user-scope config, so everything goes through its
  CLI. Codex takes its enable flags and MCP servers declaratively from
  .chezmoitemplates/codex-config-base.toml instead.
*/ -}}
#!/bin/sh
set -eu
# Re-run when the tool list or the profile changes, since either can add
# claude or codex. mise config: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# profile: {{ .profile }}
# And once claude's shim appears, e.g. after a failed `mise install` is fixed by
# hand: {{ if stat (joinPath .chezmoi.homeDir ".local/share/mise/shims/claude") }}present{{ else }}absent{{ end }}

{{ if eq .chezmoi.os "darwin" -}}
# mise is a Homebrew formula here, and its shims need it on PATH.
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$b" ]; then eval "$("$b" shellenv)"; break; fi
done

{{ end -}}
# claude and codex are mise shims, placed ahead of anything Homebrew or npm
# installed under the same name. chezmoi exec()s every script as a fresh child,
# so no other script's PATH reaches here.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

if command -v claude >/dev/null 2>&1; then
    # Re-added defensively: the marketplace is absent until claude has been
    # launched interactively at least once.
    if ! out=$(claude plugin marketplace add anthropics/claude-plugins-official 2>&1); then
        echo "WARNING: claude plugin marketplace add (official) failed:" >&2
        echo "$out" >&2
    fi
    # The marketplaces that the settings base declares. Claude registers them
    # from settings only in an interactive session, so `plugin install` below
    # would not find them on a fresh machine. `marketplace add` rewrites the
    # entry without `autoUpdate`, so it runs only for an unregistered one; the
    # next `chezmoi apply` puts `autoUpdate` back.
    known=$(claude plugin marketplace list --json 2>/dev/null || echo '[]')
{{- range $name, $m := (fromJson (includeTemplate "claude-settings-base.json" .)).extraKnownMarketplaces }}
    if ! printf '%s' "$known" | jq -e --arg n {{ $name | shellQuote }} 'any(.[]; .name == $n)' >/dev/null \
        && ! out=$(claude plugin marketplace add {{ $m.source.url | shellQuote }} 2>&1); then
        echo {{ printf "WARNING: claude plugin marketplace add %s failed:" $name | shellQuote }} >&2
        echo "$out" >&2
    fi
{{- end }}

    # No `plugin update` / `marketplace update`: the marketplaces update
    # themselves (`autoUpdate`, and FORCE_AUTOUPDATE_PLUGINS in the settings base).
    # Install only what is absent at user scope: `plugin install` on an installed
    # plugin turns it back on, and one disabled with `claude plugin disable` must
    # stay off. A project-scope install elsewhere doesn't count.
    installed=$(claude plugin list --json 2>/dev/null || echo '[]')
{{- range .plugins.claude }}
    if ! printf '%s' "$installed" | jq -e --arg id {{ . | shellQuote }} 'any(.[]; .id == $id and .scope == "user")' >/dev/null; then
        claude plugin install {{ . | shellQuote }} --scope user >/dev/null 2>&1 \
            || echo {{ printf "claude plugin install %s failed" . | shellQuote }} >&2
    fi
{{- end }}

    # Idempotent: `mcp get` succeeds when the server is already registered.
{{- range .mcp }}
    if ! claude mcp get {{ .name | shellQuote }} >/dev/null 2>&1; then
        claude mcp add -s user --transport http {{ .name | shellQuote }} {{ .url | shellQuote }} >/dev/null 2>&1 \
            && echo {{ printf "claude mcp add %s" .name | shellQuote }} \
            || echo {{ printf "claude mcp add %s failed" .name | shellQuote }} >&2
    fi
{{- end }}
else
    # Only a warning: exiting would also stop every later script (iTerm2, Touch
    # ID, chsh). The shim line in the header re-runs this once claude exists.
    echo "claude CLI not found, skipping Claude plugins (this script re-runs once mise provides it)" >&2
fi

if command -v codex >/dev/null 2>&1; then
{{- range .plugins.codex_marketplaces }}
    codex plugin marketplace add {{ . | shellQuote }} >/dev/null 2>&1 \
        || echo {{ printf "codex plugin marketplace add %s failed" . | shellQuote }} >&2
{{- end }}
    codex plugin marketplace upgrade >/dev/null 2>&1 || true
    # A plugin from an added marketplace needs `plugin add` once; the upgrade
    # above refreshes it after that. The built-in marketplace's plugins never
    # show as available: the config merge alone enables them.
    available=$(codex plugin list --json --available 2>/dev/null || echo '{}')
{{- range .plugins.codex }}
    if printf '%s' "$available" | jq -e --arg id {{ . | shellQuote }} 'any(.available[]?; .pluginId == $id)' >/dev/null; then
        codex plugin add {{ . | shellQuote }} >/dev/null 2>&1 \
            || echo {{ printf "codex plugin add %s failed" . | shellQuote }} >&2
    fi
{{- end }}
else
    echo "codex CLI not found, skipping Codex plugin install" >&2
fi
