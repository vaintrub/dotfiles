{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Make zsh the login shell. Root and passwordless sudo need no TTY; anyone else
# gets chsh's password prompt. A failure is not recorded, so the next apply
# tries again.
set -eu

zsh_path=$(command -v zsh || true)
if [ -z "$zsh_path" ]; then
    echo "ERROR: zsh not found — the packages script should have installed it." >&2
    exit 1
fi
user=$(id -un)
[ "$(getent passwd "$user" | cut -d: -f7)" = "$zsh_path" ] && exit 0

if [ "$(id -u)" -eq 0 ]; then
    sudo=
elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    sudo="sudo -n"
else
    chsh -s "$zsh_path"
    echo "login shell set to $zsh_path (re-login to take effect)"
    exit 0
fi
# Debian's chsh refuses a shell that /etc/shells does not list.
grep -qxF "$zsh_path" /etc/shells || echo "$zsh_path" | $sudo tee -a /etc/shells >/dev/null
$sudo chsh -s "$zsh_path" "$user"
echo "login shell set to $zsh_path (re-login to take effect)"
{{- end -}}
