{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(~/.ssh/id_*)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh $HOME/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "vaintrub": {
      "source": {
        "source": "git",
        "url": "https://github.com/vaintrub/skills.git"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
{{- range $i, $p := .plugins.claude }}
{{- if $i }},{{ end }}
    "{{ $p }}": true
{{- end }}
  },
  "env": {
    "DISABLE_INSTALLATION_CHECKS": "1",
    "DISABLE_AUTOUPDATER": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1"
  },
  "skipAutoPermissionPrompt": true,
  "voice": {
    "enabled": true
  }
}
