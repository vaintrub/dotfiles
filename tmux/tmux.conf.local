# Customizations on top of gpakosz/.tmux ("oh-my-tmux").
# Edit this file only — the upstream .tmux.conf is vendored as a submodule.

# --- prefix: C-a only (screen-style) ------------------------------------------
# gpakosz binds C-a as prefix2; make it primary and drop C-b entirely.
# Verbatim from the commented-out template snippet in gpakosz's .tmux.conf.local.
set -gu prefix2
unbind C-a
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# --- transparency with iTerm2 (gpakosz does NOT set these) --------------------
# Mouse: wheel scrolls tmux scrollback / drag-resizes panes / click-selects.
set -g mouse on

# Vi keys in copy mode (gpakosz already ships v/y/H/L/C-v vi-bindings but they
# only activate when mode-keys is vi).
setw -g mode-keys vi

# OSC 52 passthrough: lets vim/nvim "+y inside tmux write to the macOS pasteboard.
# (gpakosz's tmux_conf_copy_to_os_clipboard only covers explicit tmux copy-mode `y`.)
set -s set-clipboard on

# COLORTERM is set by iTerm2 outside tmux; tmux doesn't propagate it by default.
# Force it on for inner shells so any tool that probes it sees truecolor.
set-environment -g COLORTERM truecolor

# Bigger scrollback (gpakosz default 5000 is small vs. iTerm2's 10k+).
set -g history-limit 50000

# --- gpakosz native flags -----------------------------------------------------
# Force 24-bit colour on (gpakosz default `auto` depends on $COLORTERM probing,
# which can drop over SSH).
tmux_conf_24b_colour=true

# Route clipboard exclusively through OSC 52 (see `set -s set-clipboard on`
# above). With this flag at `false`, gpakosz stops splicing the
# OS-detected clipboard tool (pbcopy / xsel / xclip / wl-copy / clip.exe)
# into the mouse drag/click bindings — those bindings end up as plain
# `copy-pipe[-and-cancel]` with no command, and tmux's set-clipboard
# emits OSC 52 to the terminal which is responsible for putting bytes on
# the host clipboard. Two reasons we prefer this:
#   1. Cross-platform without OS detection — the same config works on
#      macOS (iTerm2 with AllowClipboardAccess=1) and on jetson over
#      SSH (the OSC 52 hop carries the clipboard back to iTerm2 on the
#      Mac, which is what you actually want to paste from).
#   2. The mouse-click overrides below no longer get clobbered by
#      gpakosz's _apply_configuration pass (which would otherwise
#      rewrite our `copy-pipe` to `copy-pipe pbcopy` and erase the
#      "selection persists" intent).
tmux_conf_copy_to_os_clipboard=false

# Powerline arrow separators. Verbatim from the commented suggestion in
# upstream .tmux.conf.local. Glyphs are U+E0B0–E0B3 (Powerline Symbols,
# PUA) — present in MesloLGS NF and any Nerd Font.
tmux_conf_theme_left_separator_main=''
tmux_conf_theme_left_separator_sub=''
tmux_conf_theme_right_separator_main=''
tmux_conf_theme_right_separator_sub=''

# Palette aligned with p10k pure-style accents in p10k.zsh. Hex values
# are 256-color codes p10k itself uses, converted via the ANSI 6x6x6
# cube formula (16 + 36r + 6g + b). Uses gpakosz's canonical colour_N
# slots — that way the SSH-tint branch in zshrc can point-override
# colour_15 (right-side bar-default bg) so it follows the red tint
# instead of leaving #080808 islands inside the red bar.
#
# Slots not listed here keep their gpakosz defaults, which already match
# what we want:
#   colour_6=#080808 / colour_7=#e4e4e4  → status_left_fg slots match
#   colour_12=#8a8a8a / colour_14=#080808 → status_right_fg slots 0/2 match
#   colour_15=#080808 (bar default bg)    → SSH branch overrides to #5f0000

tmux_conf_theme_colour_9='#5fafd7'    # session bg            — p10k light DIR-anchor (74)
tmux_conf_theme_colour_10='#005f87'   # uptime bg             — p10k deep DIR (24)
tmux_conf_theme_colour_13='#080808'   # user fg               — black (override default #e4e4e4)
tmux_conf_theme_colour_16='#5faf5f'   # user bg               — p10k muted OK green (71)
tmux_conf_theme_colour_17='#bcbcbc'   # host bg               — p10k light grey (250)

# colour_4 / colour_5 don't live in any trio — they feed several derived
# theme variables each, so override them directly.
#
# colour_4 → active-window bg, active pane border, pane indicators,
#   last-window fg, clock-mode colour. All "live / focused" UI.
tmux_conf_theme_colour_4='#5fd700'   # active highlights      — p10k OK green (76)
# colour_5 → message_*_bg, message_command_fg, mode_bg,
#   window_status_bell_fg. Transient attention cues
#   (config-reload messages, copy-mode highlight, window bell).
tmux_conf_theme_colour_5='#d7af00'   # messages/mode/bell     — p10k DIRENV mustard (178)

# --- Mouse UX: smoother scroll + native-feel double/triple click -------------
# gpakosz binds these by default — we override two niggles:
#
# 1. Wheel scroll defaults to 5 lines per tick → feels jumpy. Bump to 1
#    (one tick = one line, native macOS / GNOME trackpad feel).
#
# 2. Double/triple-click default chain is:
#
#        copy-mode -H ; select-word ; run-shell -d 0.3 ; copy-pipe-and-cancel [tool]
#
#    The 300 ms `run-shell` flash followed by the immediate `cancel`
#    makes the selection visibly vanish even though the word IS in the
#    clipboard. Feels like "nothing happened".
#
#    Fix: drop the artificial sleep AND the cancel — use `copy-pipe`
#    with no command. The selection persists until you press q/Esc,
#    click elsewhere, or drag to extend. Clipboard write travels via
#    OSC 52 (`set -s set-clipboard on` + the flag above set to false
#    means tmux owns the path; the terminal-emulator side handles OS
#    clipboard).
#
#    gpakosz has TWO sets of click/drag bindings: one in `root` (fires
#    when not already in copy-mode) and one in `copy-mode-vi` (fires
#    when you're already in copy-mode — e.g., after wheel-scrolling up).
#    Both sets have `-and-cancel` in upstream; we override both so the
#    selection persists in either entry path.

bind -T copy-mode-vi WheelUpPane   select-pane \; send-keys -X -N 1 scroll-up
bind -T copy-mode-vi WheelDownPane select-pane \; send-keys -X -N 1 scroll-down

bind -T root DoubleClick1Pane  select-pane -t = \; \
    if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" \
        { send-keys -M } \
        { copy-mode -H ; send-keys -X select-word ; send-keys -X copy-pipe }

bind -T root TripleClick1Pane  select-pane -t = \; \
    if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" \
        { send-keys -M } \
        { copy-mode -H ; send-keys -X select-line ; send-keys -X copy-pipe }

# When you wheel-scroll up first, you enter copy-mode and then mouse
# events route to copy-mode-vi (not root). Override the same three
# bindings here too — otherwise gpakosz's `-and-cancel` kicks you out
# of copy-mode after each click and the view snaps back to the prompt.
bind -T copy-mode-vi DoubleClick1Pane    select-pane \; \
    send-keys -X select-word \; send-keys -X copy-pipe
bind -T copy-mode-vi TripleClick1Pane    select-pane \; \
    send-keys -X select-line \; send-keys -X copy-pipe
bind -T copy-mode-vi MouseDragEnd1Pane   send-keys -X copy-pipe
