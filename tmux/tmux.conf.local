# Customizations on top of gpakosz/.tmux ("oh-my-tmux").
# Edit this file only — the upstream .tmux.conf is vendored as a submodule.

# --- prefix: C-a only (screen-style, matches user's prior config) -------------
# gpakosz binds C-a as prefix2; we make it primary and drop C-b entirely.
set -gu prefix2
unbind C-a
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# --- true color: force-on so Powerlevel10k renders identically inside tmux ---
# gpakosz's default is "auto" (detect via $COLORTERM). "true" is resilient over
# SSH where COLORTERM may not propagate.
tmux_conf_24b_colour=true

# --- macOS clipboard: yank in copy-mode writes to pbcopy (no plugin needed) --
tmux_conf_copy_to_os_clipboard=true
